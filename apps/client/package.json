    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
