# Template only. Run pnpm env:init to generate ignored local credentials.
NODE_ENV=development
AYRA_ENV=development
AYRA_BASE_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
POSTGRES_USER=migration_role
POSTGRES_PASSWORD=
POSTGRES_DB=ayra
APPLICATION_DB_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=ayra-development
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_BUCKET=ayra-development
MINIO_ROOT_USER=ayra-local
MINIO_ROOT_PASSWORD=
# Server-only providers become required in their integration milestone.
OPENAI_API_KEY=
E2B_API_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
REVENUECAT_SECRET_KEY=
KMS_KEY_ID=
